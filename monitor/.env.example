# API (FastAPI)
# Token dos agentes e chave de gestão do dashboard. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENT_TOKEN=troque-por-um-token-longo-e-aleatorio
# SQLite local, usado só quando o Turso (abaixo) não está configurado.
# Caminho relativo à pasta de onde a API é iniciada. Padrão: api/monitor.db.
DATABASE_PATH=monitor.db
# Origens autorizadas a chamar a API pelo navegador. O dashboard servido pela
# própria API não precisa disso; só um frontend em outra origem.
CORS_ORIGINS=http://localhost:8009,http://127.0.0.1:8009
# Dias de retenção das métricas (0 desativa a limpeza).
METRICS_RETENTION_DAYS=14

# Turso: quando configurado, substitui automaticamente o SQLite local.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token-secreto

