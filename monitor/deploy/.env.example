# Copie para ".env" (na mesma pasta do docker-compose.yml) e preencha. O ".env" NÃO vai para o Git.

# Token dos agentes: use o MESMO que os agentes já têm hoje (senão dá 401).
AGENT_TOKEN=troque-por-o-token-atual

# Senha do painel (editar/excluir hosts e dispositivos). Use a mesma que você usa hoje.
MANAGEMENT_PASSWORD=troque-pela-senha-do-painel

# PostgreSQL já existente em outro container. Troque usuário, senha, o nome do container (host) e o banco.
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgresql://monitor:SENHA@NOME-DO-CONTAINER-POSTGRES:5432/monitor

# Nome da rede do Docker onde o container do PostgreSQL está (docker inspect <container> mostra).
PG_NETWORK=nome-da-rede-do-postgres

# Endereço público, sem https://. Com domínio próprio: monitor.carmelhoteis.com.br
# Sem domínio, use o IP com hífens + .sslip.io (ex.: IP 3.90.12.45 -> 3-90-12-45.sslip.io).
SITE_ADDRESS=3-90-12-45.sslip.io

# Dias de histórico mantidos (padrão 14; 0 desliga a limpeza).
METRICS_RETENTION_DAYS=14
